{
  "rewrites": [{ "source": "/", "destination": "/static/index.html" }, { "source": "/api/:path*", "destination": "/api/index" }],
  "functions": { "api/*.py": { "maxDuration": 60 } },
  "headers": [
    { "source": "/static/sw.js", "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
